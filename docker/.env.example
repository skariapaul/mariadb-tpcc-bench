# Copy to .env and adjust before running: cp .env.example .env

MARIADB_VER=10.11
MARIADB_ROOT_PASSWORD=tpccpass
MARIADB_DATABASE=tpcc
MARIADB_USER=benchuser
MARIADB_PASSWORD=tpccpass

# Host port mapped to container's 3306 (use 3308+ to avoid conflict with the benchmark runner)
DB_PORT=3308

# Number of CPUs to allocate to the container
BENCH_CPUS=8
